{
  "info": {
    "_postman_id": "23440e00-3b65-524d-b390-2dd890c1e181",
    "name": "MyWay · API приёма черновиков",
    "description": "Коллекция к docs/api/openapi.yaml. Задайте переменные n8nHost и apiKey в окружении Postman (в репозитории не хранятся). После прогона отмените тестовые посты кнопкой «Отменить» в Telegram.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC-API-01 Новость с иллюстрацией",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Запрос принят в обработку\", function () { pm.expect(pm.response.json().message).to.match(/started/i); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "description": "Ожидание: 200; в БД пост approved на 12:00 МСК в пределах 2 дней; автору пришло фото-превью с кнопкой «Отменить»; заполнены photo_file_id и image_url.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"drafts\": [\n    {\n      \"type\": \"news\",\n      \"body\": \"ТЕСТ — отменить кнопкой «Отменить»\\n\\nНовость: проверка приёма, автопланирования на 12:00 и генерации картинки.\",\n      \"source_url\": \"https://cbr.ru/\",\n      \"image_prompt\": \"a glass piggy bank with coins on a wooden desk, warm morning light\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/myway-drafts-v2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "myway-drafts-v2"
          ]
        }
      }
    },
