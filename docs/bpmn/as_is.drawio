афия)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#9a6700;fontSize=11;" vertex="1" parent="1"><mxGeometry x="425" y="201.0" width="150" height="64" as="geometry"/></mxCell><mxCell id="t3" value="Запустить news_fetch.py: посты из 6 каналов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#9a6700;fontSize=11;" vertex="1" parent="1"><mxGeometry x="425" y="325.0" width="150" height="64" as="geometry"/></mxCell><mxCell id="t4" value="Отобрать темы, пересказать, перевести, дать ссылку" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#9a6700;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="325.0" width="150" height="64" as="geometry"/></mxCell><mxCell id="gm" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9a6700;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="269.0" width="52" height="52" as="geometry"/></mxCell><mxCell id="t5" value="Отправить превью (preview_news.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#9a6700;fontSize=11;" vertex="1" parent="1"><mxGeometry x="875" y="263.0" width="150" height="64" as="geometry"/></mxCell><mxCell id="t6" value="Показать превью в личке бота" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#9a6700;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1055" y="488.0" width="150" height="64" as="geometry"/></mxCell><mxCell id="g2" value="Одобряю?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9a6700;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1240" y="59.0" width="52" height="52" as="geometry"/></mxCell><mxCell id="t7" value="Доработать текст" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#9a6700;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1310" y="